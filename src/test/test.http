@app = http://localhost:8080
@keycloak = http://localhost:8081
@keycloak_realm = master
@keycloak_client_id = admin-cli
@keycloak_admin_username = admin
@keycloak_admin_password = admin
@keycloak_app_realm = movie_project_keycloak
@keycloak_app_client_id = movie_project_client
@new_username = test-admin-2026
@new_user_email = test-admin-2026@example.com
@new_user_password = admin

@keycloak_app_client_secret = FvS0v7FLwngiKKn6CTqQykNN9xqQGoLl2gJKc8YAHRJBUn8GLPAiHzi4gte7OLC8C1MNKFh0R1hOO8n0lkuigE

### Check Keycloak realm endpoint
GET {{keycloak}}/realms/{{keycloak_app_realm}}

### Request a Keycloak administrator token from master
# @name keycloakAdminToken
POST {{keycloak}}/realms/{{keycloak_realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{keycloak_client_id}}&username={{keycloak_admin_username}}&password={{keycloak_admin_password}}

### Create the application administrator (expect HTTP 201)
# @name createRealmAdmin
POST {{keycloak}}/admin/realms/{{keycloak_app_realm}}/users
Authorization: Bearer {{keycloakAdminToken.response.body.$.access_token}}
Content-Type: application/json

{
  "username": "{{new_username}}",
  "email": "{{new_user_email}}",
  "enabled": true,
  "emailVerified": true,
  "credentials": [
    {
      "type": "password",
      "value": "{{new_user_password}}",
      "temporary": false
    }
  ]
}

### Look up the new user's Keycloak ID
# @name realmAdminUser
GET {{keycloak}}/admin/realms/{{keycloak_app_realm}}/users?username={{new_username}}&exact=true
Authorization: Bearer {{keycloakAdminToken.response.body.$.access_token}}

###
@realm_admin_user_id = {{realmAdminUser.response.body.$[0].id}}

### Get the admin realm role
# @name applicationAdminRole
GET {{keycloak}}/admin/realms/{{keycloak_app_realm}}/roles/admin
Authorization: Bearer {{keycloakAdminToken.response.body.$.access_token}}

### Grant the admin realm role
POST {{keycloak}}/admin/realms/{{keycloak_app_realm}}/users/{{realm_admin_user_id}}/role-mappings/realm
Authorization: Bearer {{keycloakAdminToken.response.body.$.access_token}}
Content-Type: application/json

[
  {
    "id": "{{applicationAdminRole.response.body.$.id}}",
    "name": "{{applicationAdminRole.response.body.$.name}}"
  }
]

### Log in as the newly registered application administrator
# @name adminToken
POST {{keycloak}}/realms/{{keycloak_app_realm}}/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id={{keycloak_app_client_id}}&client_secret={{keycloak_app_client_secret}}&username={{new_username}}&password={{new_user_password}}

###
@access_token = {{adminToken.response.body.$.access_token}}

### Get a CSRF token before registration
# @name getCsrf
GET {{app}}/api/login
Authorization: Bearer {{access_token}}


## getting csrf token
@csrf_token = {{getCsrf.response.body.$.token}}

### debug csrf_token
GET {{app}}/api/debug?value={{csrf_token}}
Authorization: Bearer {{access_token}}

### Register a user in Keycloak and the application database
POST {{app}}/api/register
Content-Type: application/json
Authorization: Bearer {{access_token}}
X-XSRF-TOKEN: {{csrf_token}}

{
  "username": "{{new_username}}",
  "email": "josephemphasis18@gmail.com",
  "firstName": "Joseph",
  "lastName": "Quansah Kotei",
  "displayName": "QuansinoJosepe",
  "password": "JeP2020-2023",
  "role": "ADMIN"
}




### create artist
# @name createArtist
POST {{app}}/api/designers/add/designer
Content-Type: application/json
Authorization: Bearer {{access_token}}
X-XSRF-TOKEN: {{csrf_token}}

{
  "firstName": "Designer",
  "middleName": "Middle",
  "lastName": "Last"
}

###
@artistId = {{createArtist.response.body.$.id}}

### creating antiques
POST {{app}}/api/antiques
Content-Type: application/json
Authorization: Bearer {{access_token}}
X-XSRF-TOKEN: {{csrf_token}}

{
  "title": "Antique 1",
  "artistId": "{{artistId}}",
  "description": "This is a very nice antique found in the year 1986",
  "price": 1000.00
}

